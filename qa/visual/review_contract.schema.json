{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rivet-run-semantic-visual-review/v1",
  "title": "Rivet Run semantic player-height visual review",
  "type": "object",
  "required": ["schema", "capture_run_id", "visual_revision", "reviewer_role", "reviewed_at", "frames", "summary", "approval"],
  "properties": {
    "schema": {"const": "rivet-run-semantic-visual-review/v1"},
    "capture_run_id": {"type": "string", "minLength": 1},
    "visual_revision": {"type": "string", "minLength": 1},
    "reviewer_role": {"enum": ["AAA_INDIE_ART_DIRECTOR", "LEVEL_DESIGNER", "ENVIRONMENT_ARTIST", "TECHNICAL_ARTIST", "PARKOUR_DESIGNER", "FIRST_PERSON_MOVEMENT_DESIGNER", "PLAYER_FUN_TESTER", "PERFORMANCE_REVIEWER", "HOSTILE_QUALITY_CRITIC"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "region", "camera_position", "camera_direction", "player_state", "seed", "critic_status", "what_is_visible", "what_looks_bad", "placeholder_signals", "repetition", "unconvincing_elements", "dead_zone_assessment", "missing", "replace", "move", "add", "remove", "scores", "approved"],
        "properties": {
          "frame_id": {"type": "string"},
          "region": {"type": "string"},
          "camera_position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "camera_direction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "player_state": {"type": "string"},
          "seed": {"type": "string"},
          "critic_status": {"enum": ["INSPECTED", "NEEDS_FIX", "APPROVED"]},
          "what_is_visible": {"type": "string", "minLength": 12},
          "what_looks_bad": {"type": "array", "items": {"type": "string"}},
          "placeholder_signals": {"type": "array", "items": {"type": "string"}},
          "repetition": {"type": "array", "items": {"type": "string"}},
          "unconvincing_elements": {"type": "array", "items": {"type": "string"}},
          "dead_zone_assessment": {"type": "string", "minLength": 12},
          "missing": {"type": "array", "items": {"type": "string"}},
          "replace": {"type": "array", "items": {"type": "string"}},
          "move": {"type": "array", "items": {"type": "string"}},
          "add": {"type": "array", "items": {"type": "string"}},
          "remove": {"type": "array", "items": {"type": "string"}},
          "scores": {"type": "object", "required": ["composition", "place_believability", "materials", "route_readability", "depth_scenery", "transition", "first_person_experience", "identity", "overall"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 10}},
          "approved": {"type": "boolean"}
        }
      }
    },
    "summary": {"type": "object", "required": ["strengths", "defects", "priority_fixes"], "properties": {"strengths": {"type": "array", "items": {"type": "string"}}, "defects": {"type": "array", "items": {"type": "string"}}, "priority_fixes": {"type": "array", "items": {"type": "string"}}}},
    "approval": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"enum": ["NOT_APPROVED", "APPROVED"]}, "reason": {"type": "string"}}}
  }
}
